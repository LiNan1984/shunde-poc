# Copy to .env (gitignored) and fill locally. Never commit real tokens.
QWENPAW_MAAS_BASE_URL=https://llm-sdrdvdc4nofepa95.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWENPAW_MAAS_MODEL=qwen3.5-35b-a3b
QWENPAW_MAAS_API_KEY=

# Volcengine Ark Coding Plan — embeddings (vector KB) + optional answer rewrite
# Put the real key in ~/.qwenpaw.secret/embedding.env or this .env; never commit it.
POC_EMBEDDING_URL=https://ark.cn-beijing.volces.com/api/coding/v3
POC_EMBEDDING_MODEL=doubao-embedding-vision
POC_EMBEDDING_API_KEY=

# MinerU 2.5 (opendatalab/MinerU clone under ./MinerU, gitignored)
# Start: MinerU/.venv/bin/mineru-api --host 127.0.0.1 --port 18000
# MINERU_ENDPOINT=http://127.0.0.1:18000
# or MINERU_LOCAL=1 to call MinerU/.venv/bin/mineru CLI
MINERU_ENDPOINT=
MINERU_BACKEND=pipeline
MINERU_TIMEOUT=300

# Dedicated middleware on harness (host 3306/9200 are already taken by other apps).
# Copy passwords into ~/.qwenpaw.secret/middleware.env (mode 600); never commit them.
ELASTICSEARCH_URL=http://127.0.0.1:19200
MYSQL_URL=mysql://poc:CHANGE_ME@127.0.0.1:13306/poc_kb
GALASYBASE_URL=
POC_MYSQL_PASSWORD=CHANGE_ME
POC_MYSQL_ROOT_PASSWORD=CHANGE_ME

# Multimodal KB upgrades (2026-09): chat switch / reranker / image embeddings / vision.
# Keep values EMPTY here — real values live in ~/.qwenpaw.secret/middleware.env
# (mode 600) or the gitignored .env; never commit keys.
# Chat model for answer rewrite / analyze_page orchestration (e.g. switch back to glm-5.3-flash).
POC_CHAT_URL=
POC_CHAT_MODEL=
# Vision model that reads page PNGs (analyze_page tool), e.g. a qwen3-vl-* model id.
POC_VISION_MODEL=
# Aliyun (DashScope) key preferred by provider_api_key() for chat/rerank/vision.
POC_ALIYUN_API_KEY=
# Reranker applied after RRF fusion (top16 re-ranked), e.g. qwen3.7-text-rerank.
POC_RERANKER_URL=
POC_RERANKER_MODEL=
# Image embeddings for kind=image chunks only (qwen3-vl-embedding, dim 2560,
# its own vector space; text chunks keep the original text vectors).
POC_IMAGE_EMBEDDING_URL=
POC_IMAGE_EMBEDDING_MODEL=
POC_IMAGE_EMBEDDING_API_KEY=
